# Copy to .env.local. Do not commit real values.

# Public client settings (safe to expose in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used for invitation and password-reset links. No trailing slash.
# Production: https://protrack-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
